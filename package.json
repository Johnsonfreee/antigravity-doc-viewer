  "description": "Offline Antigravity MCP App plugin for viewing PDF, Markdown, Word (.docx), Excel/CSV, local HTML, images, and code in the sidebar.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "zeng-kaifeng",
  "scripts": {
    "build": "node scripts/build-offline.mjs",
    "typecheck": "tsc --noEmit",
