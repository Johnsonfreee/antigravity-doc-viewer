    "pack:zip": "node scripts/pack-zip.mjs",
    "test": "node tests/mcp-e2e.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "highlight.js": "^11.12.0",
    "mammoth": "^1.13.0",
    "marked": "^18.2.1",
    "pdfjs-dist": "4.10.38",
    "xlsx": "0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "jszip": "^3.10.1",
    "typescript": "^5.8.0",
    "vite": "^7.3.8",
    "vite-plugin-singlefile": "^2.3.4"
  }
